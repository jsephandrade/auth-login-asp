{
  "ConnectionStrings": {
    "AuthDb": "server=localhost;port=3306;database=auth_service;user=root;password=your_password",
    "Redis": ""
  },
  "MySql": {
    "ServerVersion": "8.0.36"
  },
  "Jwt": {
    "Issuer": "https://auth.printshop.local",
    "Audience": "https://api.printshop.local",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "CurrentKeyId": "key-2026-01",
    "Keys": [
      {
        "KeyId": "key-2026-01",
        "SecretBase64": "REPLACE_WITH_BASE64_32_BYTES_SECRET"
      }
    ]
  },
  "AuthCookie": {
    "RefreshCookieName": "refresh_token",
    "Path": "/auth/refresh",
    "SameSite": "Strict",
    "Secure": true,
    "HttpOnly": true
  },
  "Security": {
    "Pepper": "REPLACE_WITH_SERVER_PEPPER",
    "BcryptWorkFactor": 12
  },
  "TokenTtl": {
    "EmailVerificationHours": 24,
    "PasswordResetMinutes": 60
  },
  "Cache": {
    "SessionSeconds": 120,
    "PermissionSeconds": 300
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromEmail": "no-reply@printshop.local",
    "FromName": "Print Shop",
    "VerifyEmailUrlTemplate": "https://app.printshop.local/verify-email?token={token}&email={email}",
    "ResetPasswordUrlTemplate": "https://app.printshop.local/reset-password?token={token}&email={email}"
  },
  "Cors": {
    "Origins": [ "https://app.printshop.local" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
